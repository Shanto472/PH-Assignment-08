{
  "name": "civicroots-server",
  "version": "1.0.0",
  "description": "Backend API server for CivicRoots Social Development Events Platform",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/utils/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/integration.test.ts"
  },
  "keywords": [
    "express",
    "mongodb",
    "better-auth",
    "jwt",
    "social-events"
  ],
  "license": "MIT",
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "better-auth": "^1.7.20",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jose": "^6.2.17",
    "mongodb": "^7.8.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15"
  }
}
